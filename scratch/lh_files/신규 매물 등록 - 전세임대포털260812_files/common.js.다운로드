/**
 * 관련사이트 배너 이미지 롤링
 */
$(function() {
    'use strict';
    var ver = "1.0.2";
    setTimeout(function() {
        window.footerImgRoll = {};
        var footerImgRoll = window.footerImgRoll;
        footerImgRoll.ver = "0.1.1"; // 속도 조정
        footerImgRoll.img_i = -1; // 이미지 인덱스
        footerImgRoll.period = 3 * 1000; // 롤링 주기, ms 단위, 3초
        footerImgRoll.rollImage = function() {
            // 1초마다 관련사이트 버튼 안의 이미지 교체
            var $wrapper = $('.footBtn button .footWrapper');
            var $imgs = $(".ft_site .footImg");
            ++footerImgRoll.img_i;
            if (footerImgRoll.img_i >= $imgs.length) {
                footerImgRoll.img_i = 0; // 마지막 이미지를 확인했으면 첫번째로 순환
            }
            var $img = $imgs.eq(footerImgRoll.img_i).clone(); // 기존 이미지를 사용하지 않도록 clone
            var CHANGE_ATTR = false;
            if (CHANGE_ATTR) {
                $wrapper.find(".footImg").attr({
                    alt : $img.attr("alt"),
                    src : $img.attr("src"),
                }).show();
            } else {
                $wrapper.html($img.css({
                    display : "inline-block",
                }).show());
            }
        };
        var rollTimer = -1;
        footerImgRoll.setTimer = function(e) {
            var isSet = e.data.isSet;
            if (typeof isSet !== 'boolean') {
                throw "DataNotSpecifiedException";
            } else if (isSet) {
                rollTimer = window.setInterval(footerImgRoll.rollImage, footerImgRoll.period);
            } else {
                window.clearInterval(rollTimer);
            }
        };
        $(document).on("click", ".footerImgTimerOn", {
            isSet : true,
        }, footerImgRoll.setTimer);
        $(document).on("click", ".footerImgTimerOff", {
            isSet : false,
        }, footerImgRoll.setTimer);
        $(document).on("click", ".rollImage", footerImgRoll.rollImage);

        // 실행
        var interval = setTimeout(function() {
            var ver = "1.0.1";
            $(".footerImgTimerOn").eq(0).click();
        }, 100);
    }, 1);
});

