function PC_nav() {
    var $nav = $('#nav');

    $('#nav .group>li a').removeClass('active');

    $('#nav .group>li').hover(function() {
        var winW = $(window).width();
        if (winW > 960) {
            var nav_h = $('#nav .menuBox').height();

            $('#nav .group>li a').removeClass('active');
            $nav.stop().animate({
                'height' : nav_h - 20
            }, 300);
            $(this).find('.tit').addClass('active').next().stop().show();
            return false;

        }
    }, function() {
        var winW = $(window).width();
        if (winW > 960) {
            $nav.stop().animate({
                'height' : '80px'
            }, 300);
            $(this).find('.tit').removeClass('active');
            return false;
        }
    });
}
function M_nav() {

    var $mlnb = $('#mNavi');

    $mlnb.css({
        'display' : 'none',
        'left' : '-100%'
    });

    $("#menuOpen").click(function() {
        $mlnb.stop().animate({
            'left' : '0%'
        }, {
            duration : 300,
            queue : false
        }).fadeIn(500);
    });

    $("#mNavi #mtitle").click(function() {
        $mlnb.stop().animate({
            'left' : '-100%'
        }, {
            duration : 300,
            queue : false
        }).fadeOut(500);
    });

    $('#mNavi .group>li > a').click(function(event) {
        event.preventDefault(); // 1차 메뉴에 할당된 메뉴 링크 실행 방지
        if ($(this).hasClass('active')) {
            $(this).next('ul').stop().slideUp(300);
            $(this).removeClass('active');
        } else {
            $('#mNavi .group>li a').removeClass('active');
            $(this).addClass('active');
            $('#mNavi .group>li > ul').stop().slideUp(300);
            $(this).next('ul').stop().slideDown(300);
        }
    });

    $(".mNav_closed").hide();
    $("button.mNav_show").show();
}

